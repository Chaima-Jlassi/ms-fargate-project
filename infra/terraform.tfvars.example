# Copy to terraform.tfvars (which is git-ignored) and edit.

# Required: your GitHub repository, as owner/name. Only workflows on its
# main branch can push images to ECR.
github_repo = "your-github-username/ecs-fargate-microservices"

# Optional
# aws_region         = "eu-north-1"
# single_nat_gateway = true            # false = one NAT Gateway per AZ (production)
# desired_count      = 1               # 2 or more for high availability
# alert_email        = "you@example.com"
#
# Faster demo releases (default is a 5-minute canary):
# deployment_config_name = "CodeDeployDefault.ECSAllAtOnce"
#
# If this AWS account already has a GitHub OIDC provider:
# create_github_oidc_provider = false
