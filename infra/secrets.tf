# The JWT signing secret is generated by Terraform and stored in Secrets
# Manager. ECS injects it into the auth container at start; it is never in the
# image, in Git, or in the task definition (only the secret's ARN is).
resource "random_password" "jwt" {
  length  = 48
  special = false
}

resource "aws_secretsmanager_secret" "jwt" {
  name                    = "${var.project_name}/jwt-secret"
  description             = "JWT signing key for the auth service"
  recovery_window_in_days = 0 # delete immediately on destroy (demo). Use 7-30 in production.
}

resource "aws_secretsmanager_secret_version" "jwt" {
  secret_id     = aws_secretsmanager_secret.jwt.id
  secret_string = random_password.jwt.result
}
